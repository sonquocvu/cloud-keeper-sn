<UserControl x:Class="CloudKeeperSN.App.Controls.InlineNotification" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:CloudKeeperSN.App.Presentation">
    <Border x:Name="Panel" Padding="14" CornerRadius="8" BorderThickness="1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <Ellipse Stroke="{DynamicResource Information}" StrokeThickness="1.6"/>
                <Ellipse Width="2" Height="2" Fill="{DynamicResource Information}" VerticalAlignment="Top" Margin="0,3.2,0,0"/>
                <Rectangle Width="1.8" Height="6" RadiusX="0.9" RadiusY="0.9" Fill="{DynamicResource Information}" VerticalAlignment="Bottom" Margin="0,0,0,2.5"/>
            </Grid>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title, ElementName=Root}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message, ElementName=Root}" Style="{StaticResource SupportingText}" Margin="0,3,0,0"/></StackPanel>
        </Grid>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource InformationSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Information}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static presentation:StatusTone.Success}"><Setter Property="Background" Value="{DynamicResource SuccessSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Success}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static presentation:StatusTone.Warning}"><Setter Property="Background" Value="{DynamicResource WarningSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="{x:Static presentation:StatusTone.Error}"><Setter Property="Background" Value="{DynamicResource ErrorSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Error}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>
