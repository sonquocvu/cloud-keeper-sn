<UserControl x:Class="CloudKeeperSN.App.Controls.EmptyState" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" MaxWidth="520" Margin="28">
        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
            <TextBlock Text="{Binding IconGlyph, ElementName=Root}" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource SectionTitleText}" TextAlignment="Center" Margin="0,16,0,0" />
        <TextBlock Text="{Binding Message, ElementName=Root}" Style="{StaticResource SupportingText}" TextAlignment="Center" Margin="0,7,0,0" />
        <Button Content="{Binding ActionText, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                    <Style.Triggers><DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>
