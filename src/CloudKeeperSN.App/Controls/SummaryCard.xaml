<UserControl x:Class="CloudKeeperSN.App.Controls.SummaryCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" MinHeight="138">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}" />
                <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{DynamicResource AccentPrimary}" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
