<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundPrimaryColor">#161D27</Color>
    <Color x:Key="BackgroundSecondaryColor">#1D2733</Color>
    <Color x:Key="SurfacePrimaryColor">#222D3A</Color>
    <Color x:Key="SurfaceElevatedColor">#293645</Color>
    <Color x:Key="BorderSubtleColor">#3A4859</Color>
    <Color x:Key="TextPrimaryColor">#EEF3F8</Color>
    <Color x:Key="TextSecondaryColor">#B4C0CD</Color>
    <Color x:Key="TextDisabledColor">#788698</Color>
    <Color x:Key="AccentPrimaryColor">#79A9E4</Color>
    <Color x:Key="AccentHoverColor">#94BCEC</Color>
    <Color x:Key="AccentSoftColor">#283F59</Color>
    <Color x:Key="SuccessColor">#73C99C</Color>
    <Color x:Key="SuccessSoftColor">#203E31</Color>
    <Color x:Key="WarningColor">#E4B85E</Color>
    <Color x:Key="WarningSoftColor">#493A20</Color>
    <Color x:Key="ErrorColor">#EF8A8A</Color>
    <Color x:Key="ErrorSoftColor">#4D292D</Color>
    <Color x:Key="InformationColor">#8AB7EC</Color>
    <Color x:Key="InformationSoftColor">#283F59</Color>
    <Color x:Key="NavigationBackgroundColor">#121A24</Color>
    <Color x:Key="NavigationHoverColor">#263444</Color>
    <Color x:Key="NavigationSelectedColor">#30445A</Color>
    <Color x:Key="NavigationTextColor">#F2F6FA</Color>
    <Color x:Key="NavigationTextMutedColor">#AAB8C7</Color>
    <Color x:Key="OverlayColor">#99080D13</Color>

    <SolidColorBrush x:Key="BackgroundPrimary" Color="{StaticResource BackgroundPrimaryColor}" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="SurfacePrimary" Color="{StaticResource SurfacePrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoft" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="Information" Color="{StaticResource InformationColor}" />
    <SolidColorBrush x:Key="InformationSoft" Color="{StaticResource InformationSoftColor}" />
    <SolidColorBrush x:Key="NavigationBackground" Color="{StaticResource NavigationBackgroundColor}" />
    <SolidColorBrush x:Key="NavigationHover" Color="{StaticResource NavigationHoverColor}" />
    <SolidColorBrush x:Key="NavigationSelected" Color="{StaticResource NavigationSelectedColor}" />
    <SolidColorBrush x:Key="NavigationText" Color="{StaticResource NavigationTextColor}" />
    <SolidColorBrush x:Key="NavigationTextMuted" Color="{StaticResource NavigationTextMutedColor}" />
    <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}" />
</ResourceDictionary>

