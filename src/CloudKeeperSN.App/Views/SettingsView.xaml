<UserControl x:Class="CloudKeeperSN.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:CloudKeeperSN.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="980">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Giao diện" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock Text="Thay đổi được áp dụng ngay và được ghi nhớ cho lần mở sau." Style="{StaticResource SupportingText}" Margin="0,4,0,14"/>
                    <Border Width="280" HorizontalAlignment="Left" Background="#FFFFFFFF" BorderBrush="#FF667085" BorderThickness="1" CornerRadius="7" Padding="1">
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                  Foreground="#FF172033" Background="#FFFFFFFF" BorderThickness="0"
                                  automation:AutomationProperties.Name="Chọn giao diện">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="10,7" />
                                    <Setter Property="Foreground" Value="#FF172033" />
                                    <Setter Property="Background" Value="#FFFFFFFF" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Foreground" Value="#FF172033" />
                                            <Setter Property="Background" Value="#FFE8F1FF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#FF172033" />
                                            <Setter Property="Background" Value="#FFDCEAFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VietnameseLabel}" Foreground="#FF172033" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding IsGoogleOAuthAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Kết nối dịch vụ" Style="{StaticResource SectionTitleText}"
                               automation:AutomationProperties.HeadingLevel="Level2"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kết nối Google Drive" Style="{StaticResource CardTitleText}"
                                       automation:AutomationProperties.HeadingLevel="Level3"/>
                            <TextBlock Text="Nhập file OAuth dành cho ứng dụng máy tính được tải xuống từ Google Cloud Console."
                                       Style="{StaticResource SupportingText}" Margin="0,4,18,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:StatusBadge Grid.Column="1" Text="{Binding GoogleOAuthStatus.Text}" Tone="{Binding GoogleOAuthStatus.Tone}"
                                              automation:AutomationProperties.LiveSetting="Polite"/>
                    </Grid>

                    <Border Margin="0,14,0,0" Padding="12" CornerRadius="7" Background="{DynamicResource BackgroundSecondary}">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Loại ứng dụng" Style="{StaticResource CardTitleText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GoogleOAuthApplicationType}" Style="{StaticResource SupportingText}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Nguồn cấu hình" Style="{StaticResource CardTitleText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GoogleOAuthSource}" Style="{StaticResource SupportingText}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0" Visibility="{Binding HasGoogleOAuthMetadata, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Client ID" Style="{StaticResource CardTitleText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GoogleOAuthMaskedClientId}" Style="{StaticResource SupportingText}"
                                           automation:AutomationProperties.Name="Client ID Google OAuth đã che"/>
                            </Grid>
                            <Grid Margin="0,8,0,0" Visibility="{Binding HasGoogleOAuthMetadata, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Thời điểm nhập" Style="{StaticResource CardTitleText}"/>
                                <TextBlock Grid.Column="1" Text="{Binding GoogleOAuthImportedAt}" Style="{StaticResource SupportingText}"/>
                            </Grid>
                            <TextBlock Text="{Binding GoogleOAuthValidationMessage}" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <controls:InlineNotification Title="Google Drive luôn là nguồn chỉ đọc"
                                                 Message="CloudKeeperSN chỉ yêu cầu quyền đọc Google Drive và không thể sửa hoặc xóa dữ liệu nguồn. Nhập file OAuth chỉ cấu hình ứng dụng; bạn vẫn đăng nhập an toàn trong trình duyệt hệ thống."
                                                 Margin="0,14,0,0"/>

                    <TextBlock Text="{Binding GoogleOAuthErrorMessage}" Foreground="{DynamicResource Error}" Margin="0,12,0,0"
                               TextWrapping="Wrap" Visibility="{Binding GoogleOAuthErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                               automation:AutomationProperties.LiveSetting="Assertive"/>
                    <TextBlock Text="{Binding GoogleOAuthActionMessage}" Foreground="{DynamicResource Success}" Margin="0,12,0,0"
                               TextWrapping="Wrap" Visibility="{Binding GoogleOAuthActionMessage, Converter={StaticResource NullToVisibilityConverter}}"
                               automation:AutomationProperties.LiveSetting="Polite"/>

                    <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Hướng dẫn lấy file OAuth" Command="{Binding ShowGoogleOAuthGuideCommand}" Margin="0,0,8,0"
                                ToolTip="Xem các bước tải OAuth JSON loại Desktop app"
                                automation:AutomationProperties.Name="Hướng dẫn lấy file OAuth Google"/>
                        <Button Content="Xóa cấu hình" Command="{Binding RemoveGoogleOAuthCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                Visibility="{Binding CanRemoveGoogleOAuth, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Xóa cấu hình và authorization cache cục bộ; không thay đổi dữ liệu Google Drive"
                                automation:AutomationProperties.Name="Xóa cấu hình Google OAuth"/>
                        <Button Content="{Binding GoogleOAuthPrimaryActionText}" Command="{Binding ImportGoogleOAuthCommand}" Style="{StaticResource PrimaryButton}"
                                ToolTip="Chọn file JSON OAuth Desktop được tải từ Google Cloud Console"
                                automation:AutomationProperties.Name="Chọn file OAuth JSON của Google"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Truyền dữ liệu" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Số tệp truyền đồng thời" Style="{StaticResource CardTitleText}"/><TextBlock Text="Từ 1 đến 8. Giá trị thấp giúp giảm áp lực bộ nhớ và giới hạn dịch vụ." Style="{StaticResource CaptionText}" Margin="0,3,12,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding ConcurrentTransfers, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Số tệp truyền đồng thời"/></Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Giới hạn lưu tạm (MB)" Style="{StaticResource CardTitleText}"/><TextBlock Text="Từ 128 đến 8192 MB. Dữ liệu tạm được xóa sau khi truyền thành công." Style="{StaticResource CaptionText}" Margin="0,3,12,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding CacheLimitMiB, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Giới hạn lưu tạm theo MB"/></Grid>
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Số lần thử lại tối đa" Style="{StaticResource CardTitleText}"/><TextBlock Text="Từ 1 đến 10. Thời gian chờ tăng dần và tôn trọng giới hạn của dịch vụ." Style="{StaticResource CaptionText}" Margin="0,3,12,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding RetryAttempts, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Số lần thử lại tối đa"/></Grid>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Error}" Margin="0,12,0,0"/>
                    <Button Content="Lưu cài đặt truyền dữ liệu" Command="{Binding SaveTransferSettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dữ liệu cục bộ" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Cơ sở dữ liệu" Style="{StaticResource CardTitleText}"/><TextBlock Grid.Column="1" Text="{Binding DatabasePath}" Style="{StaticResource SupportingText}" TextTrimming="CharacterEllipsis"/></Grid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Nhật ký" Style="{StaticResource CardTitleText}"/><TextBlock Grid.Column="1" Text="{Binding LogPath}" Style="{StaticResource SupportingText}" TextTrimming="CharacterEllipsis"/></Grid>
                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Bộ nhớ tạm" Style="{StaticResource CardTitleText}"/><TextBlock Grid.Column="1" Text="{Binding CachePath}" Style="{StaticResource SupportingText}" TextTrimming="CharacterEllipsis"/></Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Xóa bộ nhớ tạm" Command="{Binding ClearCacheCommand}" ToolTip="Chỉ xóa tệp tạm của CloudKeeperSN"/><Button Content="Xuất thông tin chẩn đoán" Command="{Binding ExportDiagnosticsCommand}" Margin="8,0,0,0" ToolTip="Token và thông tin nhạy cảm sẽ được ẩn"/></StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ứng dụng" Style="{StaticResource SectionTitleText}"/><TextBlock Text="CloudKeeperSN — Bảo vệ dữ liệu đám mây" Style="{StaticResource SupportingText}" Margin="0,6,0,0"/><TextBlock Text="Giấy phép của các thư viện mã nguồn mở được cung cấp cùng gói phát hành." Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Version, StringFormat=Phiên bản {0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding BuildInformation}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel></Grid>
            </Border>
            <TextBlock Text="{Binding ActionMessage}" Foreground="{DynamicResource Success}" Margin="4,14,4,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
