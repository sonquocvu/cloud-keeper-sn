<Window x:Class="CloudKeeperSN.App.Views.Dialogs.FolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:CloudKeeperSN.App.Controls"
        Title="Chọn thư mục" Width="680" Height="560" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BackgroundPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level1"/>
        <Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="\uE72B" FontFamily="Segoe Fluent Icons" Style="{StaticResource IconButton}" Command="{Binding GoUpCommand}" ToolTip="Quay lại thư mục trước"/>
            <Border Grid.Column="1" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="8,0,0,0"><TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis"/></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedEntry}" automation:AutomationProperties.Name="Các thư mục con">
                    <ListBox.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentPrimary}" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}"/></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <controls:LoadingIndicator Message="Đang tải thư mục…" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <controls:EmptyState Title="Thư mục này đang trống" Message="Bạn vẫn có thể chọn thư mục hiện tại." IconGlyph="\uE8B7" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding CanCreateFolder, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Tên thư mục mới" ToolTip="Nhập tên thư mục mới trên OneDrive"/>
            <Button Grid.Column="1" Content="Tạo thư mục" Command="{Binding CreateFolderCommand}" Margin="8,0,0,0"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Chỉ hiển thị thư mục" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Hủy" Click="CancelClick" IsCancel="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Chọn thư mục này" Click="SelectClick" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</Window>

