<UserControl x:Class="CloudKeeperSN.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:CloudKeeperSN.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Sao lưu an toàn, rõ ràng và có kiểm soát" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Google Drive là nguồn • OneDrive là nơi lưu bản sao • Không xóa dữ liệu nguồn" Style="{StaticResource SupportingText}" Margin="0,5,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="_Tạo bản sao lưu" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" automation:AutomationProperties.Name="Tạo bản sao lưu"/>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,-12,24">
                <controls:SummaryCard DataContext="{Binding GoogleCard}" Margin="0,0,12,0"/>
                <controls:SummaryCard DataContext="{Binding OneDriveCard}" Margin="0,0,12,0"/>
                <controls:SummaryCard DataContext="{Binding LastBackupCard}" Margin="0,0,12,0"/>
                <controls:SummaryCard DataContext="{Binding PendingCard}" Margin="0,0,12,0"/>
            </UniformGrid>

            <TextBlock Text="Hoạt động gần đây" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14" automation:AutomationProperties.HeadingLevel="Level2"/>
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <controls:EmptyState Title="Chưa có lần sao lưu nào" Message="Kết nối hai tài khoản rồi tạo bản sao lưu đầu tiên. Bạn luôn được xem trước trước khi dữ liệu được truyền." IconGlyph="\uE81C" ActionText="Tạo bản sao lưu" ActionCommand="{Binding CreateBackupCommand}"/>
            </Border>
            <ListBox ItemsSource="{Binding RecentRuns}" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" automation:AutomationProperties.Name="Danh sách hoạt động sao lưu gần đây">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitleText}"/>
                                    <TextBlock Text="{Binding Route}" Style="{StaticResource SupportingText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding StartedAt}" Style="{StaticResource CaptionText}"/><TextBlock Text=" • " Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding FileSummary}" Style="{StaticResource CaptionText}"/><TextBlock Text=" • " Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Capacity}" Style="{StaticResource CaptionText}"/></StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <controls:StatusBadge Text="{Binding Status.Text}" Tone="{Binding Status.Tone}" HorizontalAlignment="Right"/>
                                    <controls:StatusBadge Text="{Binding Verification.Text}" Tone="{Binding Verification.Tone}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                    <Button Content="Xem chi tiết" Style="{StaticResource TextButton}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>

