<UserControl x:Class="CloudKeeperSN.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:CloudKeeperSN.App.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="32,12">
            <Grid>
                <UniformGrid Columns="6" Visibility="{Binding IsDemoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="1. Chọn nguồn" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="2. Chọn nơi lưu" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="3. Quét và xem trước" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="4. Xác nhận" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="5. Sao lưu" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="6. Xem kết quả" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                </UniformGrid>
                <UniformGrid Columns="3" Visibility="{Binding IsProductionMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="1. Chọn nguồn" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="2. Quét siêu dữ liệu" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                <TextBlock Text="3. Xem kế hoạch" Style="{StaticResource CaptionText}" TextAlignment="Center"/>
                </UniformGrid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource PagePadding}">
                <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:InlineNotification Title="Sao lưu an toàn theo một chiều" Message="Google Drive là nguồn. OneDrive là nơi lưu bản sao. Không xóa dữ liệu nguồn và không ghi đè theo mặc định." Margin="0,0,0,20" Visibility="{Binding IsDemoMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <controls:InlineNotification Title="Google Drive chỉ đọc" Message="Bản dựng hiện tại chỉ kết nối, duyệt và quét siêu dữ liệu để lập kế hoạch. Không tải xuống, không xuất và không truyền nội dung tệp." Margin="0,0,0,20" Visibility="{Binding IsProductionMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="1. Chọn nguồn" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Text="Google Drive" Style="{StaticResource CardTitleText}" Margin="0,18,0,0"/>
                                <TextBlock Text="{Binding AccountDisplayName}" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/>
                                <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="7" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding SourceFolderLabel}" TextTrimming="CharacterEllipsis"/></Border>
                                <Button Content="Chọn thư mục nguồn" Command="{Binding SelectSourceCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" automation:AutomationProperties.Name="Chọn thư mục nguồn trên Google Drive"/>
                                <TextBlock Text="CloudKeeperSN chỉ đọc dữ liệu từ Google Drive và không thay đổi hoặc xóa dữ liệu nguồn." Style="{StaticResource CaptionText}" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding IsDemoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="2. Chọn nơi lưu" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Text="OneDrive" Style="{StaticResource CardTitleText}" Margin="0,18,0,0"/>
                                <TextBlock Text="Tài khoản trình diễn Nguyễn Minh An" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/>
                                <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="7" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding DestinationFolderLabel}" TextTrimming="CharacterEllipsis"/></Border>
                                <Button Content="Chọn hoặc tạo thư mục" Command="{Binding SelectDestinationCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" automation:AutomationProperties.Name="Chọn nơi lưu bản sao trên OneDrive"/>
                                <TextBlock Text="Các tệp đang có trên OneDrive sẽ không bị ghi đè theo mặc định." Style="{StaticResource CaptionText}" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="3. Quét và xem trước" Style="{StaticResource CardTitleText}"/><TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource SupportingText}" Margin="0,4,18,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,16,0">
                                    <controls:LoadingIndicator Message="Đang quét nguồn…"/>
                                    <Button Content="_Hủy quét" Command="{Binding CancelScanCommand}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="_Quét và xem trước" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" automation:AutomationProperties.HelpText="Không truyền tệp; chỉ tạo bản xem trước"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding ScanProgressText}" Style="{StaticResource CaptionText}" Margin="4,10,4,0" automation:AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding ScanErrorMessage}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" Margin="4,8,4,0" automation:AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>

                <StackPanel Visibility="{Binding IsPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:InlineNotification Title="Bản xem trước bắt buộc" Message="Hãy kiểm tra những gì sẽ sao lưu, bỏ qua hoặc đổi tên. Chưa có dữ liệu nào được truyền." Margin="0,0,0,18"/>
                    <UniformGrid Columns="7" Margin="0,0,-8,18">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Tổng tệp" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Preview.FileCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Tổng thư mục" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Preview.FolderCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Sẽ sao lưu" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Preview.NewCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Sẽ bỏ qua" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Preview.SkipCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Xung đột tên" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Preview.ConflictCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Không hỗ trợ" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Preview.UnsupportedCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Chưa rõ kích thước" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Preview.UnknownSizeCount}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding PreviewFilters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" Width="190" automation:AutomationProperties.Name="Lọc bản xem trước"/><TextBox Text="{Binding PreviewSearch, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="10,0,0,0" automation:AutomationProperties.Name="Tìm trong bản xem trước"/></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Preview.EstimatedBytes, StringFormat=Dung lượng nguồn ước tính: {0:N0} byte}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding VisiblePreviewItems}" MaxHeight="360" automation:AutomationProperties.Name="Các mục trong bản xem trước">
                                <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="8,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding OriginalName}" FontWeight="SemiBold"/><TextBlock Text="{Binding RelativePath}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Reason}" Style="{StaticResource SupportingText}" Margin="0,5,12,0"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding DestinationName}" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/></StackPanel>
                                    <controls:StatusBadge Grid.Column="2" Text="{Binding CategoryStatus.Text}" Tone="{Binding CategoryStatus.Tone}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding TransferAvailabilityMessage}" Style="{StaticResource SupportingText}" TextWrapping="Wrap" VerticalAlignment="Center" automation:AutomationProperties.LiveSetting="Polite"/>
                        <Button Grid.Column="1" Content="_Bắt đầu sao lưu" Command="{Binding StartBackupCommand}" Style="{StaticResource PrimaryButton}"
                                ToolTip="{Binding TransferAvailabilityMessage}" ToolTipService.ShowOnDisabled="True"/>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="900" HorizontalAlignment="Center">
                    <Border Style="{StaticResource ElevatedCard}" Padding="28">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Đang sao lưu một chiều" Style="{StaticResource SectionTitleText}"/><controls:StatusBadge Grid.Column="1" Text="Đang xử lý" Tone="Information"/></Grid>
                            <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100" Height="12" Margin="0,24,0,0" automation:AutomationProperties.Name="Tiến độ sao lưu tổng thể"/>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FileProgress}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ByteProgress}" Style="{StaticResource SupportingText}"/></Grid>
                            <Border Background="{DynamicResource BackgroundSecondary}" CornerRadius="8" Padding="16" Margin="0,20,0,0"><StackPanel><TextBlock Text="{Binding CurrentFile}" Style="{StaticResource CardTitleText}"/><TextBlock Text="{Binding CurrentOperation}" Style="{StaticResource SupportingText}" Margin="0,4,0,0"/></StackPanel></Border>
                            <UniformGrid Columns="5" Margin="0,18,0,0"><TextBlock Text="{Binding CompletedCount, StringFormat=Hoàn tất: {0}}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding SkippedCount, StringFormat=Bỏ qua: {0}}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding WarningCount, StringFormat=Cảnh báo: {0}}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding FailedCount, StringFormat=Lỗi: {0}}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding RetryCount, StringFormat=Thử lại: {0}}" Style="{StaticResource CaptionText}"/></UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="Tạm dừng" Command="{Binding PauseCommand}"/><Button Content="Tiếp tục" Command="{Binding ResumeCommand}" Margin="8,0,0,0"/><Button Content="Hủy sao lưu" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="20,0,0,0"/></StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsResult, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="900" HorizontalAlignment="Center">
                    <Border Style="{StaticResource ElevatedCard}" Padding="28">
                        <StackPanel>
                            <controls:StatusBadge Text="{Binding Result.Headline}" Tone="{Binding Result.Tone}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding Result.Headline}" FontSize="26" FontWeight="SemiBold" Margin="0,16,0,0"/>
                            <TextBlock Text="{Binding Result.DestinationPath, StringFormat=Nơi lưu bản sao: {0}}" Style="{StaticResource SupportingText}" Margin="0,5,0,0"/>
                            <UniformGrid Columns="4" Margin="0,24,0,0"><Border Style="{StaticResource Card}" Margin="0,0,8,0"><TextBlock Text="{Binding Result.CompletedCount, StringFormat=Hoàn tất\n{0}}" TextAlignment="Center"/></Border><Border Style="{StaticResource Card}" Margin="0,0,8,0"><TextBlock Text="{Binding Result.SkippedCount, StringFormat=Bỏ qua\n{0}}" TextAlignment="Center"/></Border><Border Style="{StaticResource Card}" Margin="0,0,8,0"><TextBlock Text="{Binding Result.WarningCount, StringFormat=Cảnh báo\n{0}}" TextAlignment="Center"/></Border><Border Style="{StaticResource Card}"><TextBlock Text="{Binding Result.FailedCount, StringFormat=Chưa hoàn tất\n{0}}" TextAlignment="Center"/></Border></UniformGrid>
                            <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Xác minh" Style="{StaticResource CardTitleText}"/><controls:StatusBadge Text="{Binding Result.Verification.Text}" Tone="{Binding Result.Verification.Tone}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Dung lượng và thời gian" Style="{StaticResource CardTitleText}"/><TextBlock Text="{Binding Result.TransferredCapacity}" Margin="0,8,0,0"/><TextBlock Text="{Binding Result.TimeRange}" Style="{StaticResource CaptionText}"/></StackPanel></Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Thử lại tệp lỗi" Command="{Binding RetryFailedCommand}"/><Button Content="Mở lịch sử" Command="{Binding OpenHistoryCommand}" Margin="8,0,0,0"/><Button Content="Tạo bản sao lưu mới" Command="{Binding NewBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
