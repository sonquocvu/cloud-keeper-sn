<UserControl x:Class="CloudKeeperSN.App.Views.InventoryPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:vm="clr-namespace:CloudKeeperSN.App.ViewModels"
             xmlns:controls="clr-namespace:CloudKeeperSN.App.Controls">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <controls:InlineNotification Title="Kế hoạch cục bộ, chưa phải bản sao lưu"
                Message="Lựa chọn chỉ được lưu trong CloudKeeperSN. Không có tệp nào được tải xuống, xuất, truyền hoặc thay đổi trên Google Drive."/>
            <controls:InlineNotification Title="Đối chiếu snapshot mới" Message="{Binding ReconciliationMessage}" Tone="Warning" Margin="0,12,0,0"
                Visibility="{Binding HasReconciliationMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Xóa quy tắc không còn đích" Command="{Binding RemoveMissingRulesCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding HasMissingRules, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <controls:LoadingIndicator Message="Đang mở danh mục Google Drive…" Margin="0,12,0,0"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <controls:EmptyState Title="Chưa thể mở danh mục" Message="{Binding StatusMessage}" IconGlyph="\uE8B7" Margin="0,16,0,0"
                Visibility="{Binding HasNoSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,16"
                Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tên kế hoạch" Style="{StaticResource CaptionText}"/>
                    <TextBox Text="{Binding PlanName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,18,0" MaxLength="120"
                             automation:AutomationProperties.Name="Tên kế hoạch sao lưu cục bộ"/>
                    <TextBlock Text="{Binding SnapshotLabel, StringFormat=Snapshot: {0}}" Style="{StaticResource CaptionText}" Margin="0,7,0,0"/>
                    <TextBlock Text="Có thay đổi chưa lưu" Foreground="{DynamicResource Warning}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" Columns="3" Margin="0,0,18,0">
                    <StackPanel><TextBlock Text="Mục đã chọn" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding SelectedItemCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel><TextBlock Text="Dung lượng biết trước" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding KnownBytesLabel}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel><TextBlock Text="Cần kiểm tra" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ReviewItemCount}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                </UniformGrid>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <Button Content="_Lưu kế hoạch" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Bỏ toàn bộ lựa chọn" Command="{Binding ClearSelectionCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Cấu trúc thư mục" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Text="Chọn thư mục để bao gồm hậu duệ; bỏ chọn một mục con để tạo ngoại lệ." Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TreeView Grid.Row="1" ItemsSource="{Binding TreeRoots}" VirtualizingStackPanel.IsVirtualizing="True"
                              automation:AutomationProperties.Name="Cấu trúc danh mục Google Drive">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:InventoryItemNodeViewModel}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsSelectable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              automation:AutomationProperties.Name="{Binding Name, StringFormat=Chọn {0}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="310"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Tìm kiếm và lọc" Style="{StaticResource SectionTitleText}" automation:AutomationProperties.HeadingLevel="Level2"/>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                 automation:AutomationProperties.Name="Tìm theo tên hoặc đường dẫn"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label"
                                  automation:AutomationProperties.Name="Lọc danh mục"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" automation:AutomationProperties.Name="Kết quả danh mục">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="6,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="0,3,8,0"
                                                  automation:AutomationProperties.Name="{Binding Name, StringFormat=Chọn {0}}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding EligibilityLabel}" Style="{StaticResource SupportingText}" TextWrapping="Wrap" Margin="0,3,8,0"/>
                                            <TextBlock Text="{Binding SelectionNote}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource CaptionText}" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource CaptionText}" TextAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SelectedFolderCount, StringFormat=Thư mục được bao gồm: {0:N0}}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding BackupEligibleItemCount, StringFormat=Mục đủ điều kiện sao lưu tương lai: {0:N0}}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding UnknownSizeCount, StringFormat=Mục đã chọn chưa rõ kích thước: {0:N0}}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding SelectedReviewItemCount, StringFormat=Mục đã chọn nhưng cần kiểm tra: {0:N0}}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding SaveMessage}" Foreground="{DynamicResource Success}" TextWrapping="Wrap" Margin="0,7,0,0" automation:AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
