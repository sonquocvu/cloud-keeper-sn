<Window x:Class="CloudKeeperSN.App.MainWindow"
        x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:converters="clr-namespace:CloudKeeperSN.App.UI.Converters"
        Title="CloudKeeperSN — Bảo vệ dữ liệu đám mây"
        Icon="Assets/CloudKeeperSN.ico"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <converters:NavigationWidthConverter x:Key="NavigationWidthConverter" />
        <converters:CompactVisibilityConverter x:Key="CompactVisibilityConverter" />
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource NavigationText}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="automation:AutomationProperties.Name" Value="{Binding ToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavigationHover}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.78" /></Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource NavigationSelected}" /></DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundPrimary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=ShellWindow, Converter={StaticResource NavigationWidthConverter}}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource NavigationBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="20,24,16,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#F3F7FC" Padding="3">
                        <Image Source="Assets/CloudKeeperSN-icon.png" Stretch="Uniform"
                               automation:AutomationProperties.Name="Biểu tượng CloudKeeperSN" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                Visibility="{Binding ActualWidth, ElementName=ShellWindow, Converter={StaticResource CompactVisibilityConverter}, ConverterParameter=Expanded}">
                        <TextBlock Text="CloudKeeperSN" Style="{StaticResource ApplicationTitleText}" Foreground="{DynamicResource NavigationText}" />
                        <TextBlock Text="Bảo vệ dữ liệu đám mây" Style="{StaticResource CaptionText}" Foreground="{DynamicResource NavigationTextMuted}" />
                    </StackPanel>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavigationButton}" Command="{Binding DataContext.NavigateCommand, ElementName=ShellWindow}" CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{DynamicResource NavigationText}" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" Foreground="{DynamicResource NavigationText}" FontWeight="SemiBold"
                                               Visibility="{Binding ActualWidth, ElementName=ShellWindow, Converter={StaticResource CompactVisibilityConverter}, ConverterParameter=Expanded}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Margin="16,12,16,18">
                    <Border Padding="10,7" CornerRadius="7" Background="{DynamicResource NavigationHover}">
                        <TextBlock Text="{Binding EnvironmentLabel}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource NavigationText}" TextAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource NavigationTextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="32,20">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource PageTitleText}" automation:AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding CurrentPageSubtitle}" Style="{StaticResource SupportingText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
            <Border Grid.Row="2" Background="{DynamicResource SurfacePrimary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="●" Foreground="{DynamicResource Success}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding GlobalStatus}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
