# Optional development/diagnostic fallback. Normal setup imports Desktop OAuth JSON in Settings.
# Both variables must be supplied together. Never commit real values in another tracked file.
CLOUDKEEPERSN_GOOGLE_CLIENT_ID=
CLOUDKEEPERSN_GOOGLE_CLIENT_SECRET=

# The installed-app OAuth receiver chooses a free 127.0.0.1 loopback port.
# Do not add access tokens, refresh tokens, authorization codes, or real secrets here.

# UI development showcase. Release builds never enable this implicitly.
CLOUDKEEPERSN_DEMO_MODE=false
# Disconnected | GoogleOnly | ConnectedEmpty | Standard | LongRunning |
# CompletedSuccessfully | CompletedWithWarnings | RetryAndFailure
CLOUDKEEPERSN_DEMO_SCENARIO=Standard
