# Safe development template. Never commit real values in another tracked file.
CLOUDKEEPERSN_GOOGLE_CLIENT_ID=
CLOUDKEEPERSN_GOOGLE_REDIRECT_URI=http://127.0.0.1:53682/oauth/google/callback
CLOUDKEEPERSN_MICROSOFT_CLIENT_ID=
CLOUDKEEPERSN_MICROSOFT_TENANT=consumers
CLOUDKEEPERSN_MICROSOFT_REDIRECT_URI=http://127.0.0.1:53683/oauth/microsoft/callback

# Conservative future transfer defaults.
CLOUDKEEPERSN_MAX_CONCURRENT_TRANSFERS=2
CLOUDKEEPERSN_TEMP_CACHE_MAX_MIB=1024

# UI development showcase. Release builds never enable this implicitly.
CLOUDKEEPERSN_DEMO_MODE=false
# Disconnected | GoogleOnly | ConnectedEmpty | Standard | LongRunning |
# CompletedSuccessfully | CompletedWithWarnings | RetryAndFailure
CLOUDKEEPERSN_DEMO_SCENARIO=Standard
